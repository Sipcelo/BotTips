# ============================================
# ValueBot — .env.example
# Copie para .env e preencha os valores reais
# ============================================

# Database
DATABASE_URL=postgresql://valuebot:sua_senha@127.0.0.1:5433/valuebot

# === APIs de Dados ===
ODDS_API_KEY=
TENNIS_API_KEY=
SPORTS_API_KEY=
# OpenRouter — contexto qualitativo dos alertas (opcional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# === Telegram ===
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# === Configurações do Bot ===
MIN_EV=0.04
MIN_ODD=1.60
MAX_ODD=4.00
MAX_MARGIN=0.10
KELLY_FRACTION=0.25
MAX_STAKE_PCT=0.03
POLL_INTERVAL_SECONDS=300

# Ambiente: development | production
ENVIRONMENT=development
